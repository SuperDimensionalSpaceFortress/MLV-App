+class WorktreeBase(Base):
+    def cfg_path(self, **extra) -> Path:
+        p = self.r.root / "cfg.json"
+        p.write_text(json.dumps(worktree_config(**extra)), encoding="utf-8")
+        return p
+
+    def listing_and_visits(self, **extra) -> tuple[list[str], list[str]]:
+        """Run Checker.listing() in-process; also return every directory os.walk actually yielded (entered)."""
+        spec = importlib.util.spec_from_file_location("check_doc_size_under_test", TOOL)
+        mod = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(mod)
+        cfg = mod.load_config(self.cfg_path(**extra))
+        real_walk, visited = os.walk, []
+
+        def spy(top, *a, **k):
+            for item in real_walk(top, *a, **k):
+                visited.append(Path(os.path.relpath(item[0], self.r.root)).as_posix())
+                yield item
+
+        with mock.patch.object(os, "walk", spy):
+            listing = mod.Checker(cfg, self.r.root.resolve()).listing()
+        return sorted(listing), visited
+
