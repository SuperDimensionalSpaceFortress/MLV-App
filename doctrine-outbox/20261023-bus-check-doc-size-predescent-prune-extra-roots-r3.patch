+def worktree_config(**extra) -> dict:
+    cfg = {"schema": "factory-check-doc-size.v1", "scan": "worktree", "tier_order": ["working"],
+           "tiers": {"working": {"soft": 100, "hard": 200, "globs": []}}}
+    cfg.update(extra)
+    return cfg
