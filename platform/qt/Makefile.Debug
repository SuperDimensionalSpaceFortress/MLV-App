QMAKE_TARGET  = MLVApp
DESTDIR        = debug/ #avoid trailing-slash linebreak
TARGET         = MLVApp.exe
DESTDIR_TARGET = debug/MLVApp.exe

####### Build rules

first: all
all: Makefile.Debug  debug/MLVApp.exe

debug/MLVApp.exe: C:/Qt/6.10.2/mingw_64/lib/libQt6Multimedia.a C:/Qt/6.10.2/mingw_64/lib/libQt6OpenGLWidgets.a C:/Qt/6.10.2/mingw_64/lib/libQt6OpenGL.a C:/Qt/6.10.2/mingw_64/lib/libQt6Widgets.a C:/Qt/6.10.2/mingw_64/lib/libQt6Gui.a C:/Qt/6.10.2/mingw_64/lib/libQt6Network.a C:/Qt/6.10.2/mingw_64/lib/libQt6Core.a C:/Qt/6.10.2/mingw_64/lib/libQt6EntryPoint.a ui/ui_MainWindow.h ui/ui_InfoDialog.h ui/ui_RenameDialog.h ui/ui_StatusDialog.h ui/ui_ExportSettingsDialog.h ui/ui_EditSliderValueDialog.h ui/ui_cupdaterdialog.h ui/ui_FcpxmlAssistantDialog.h ui/ui_FcpxmlSelectDialog.h ui/ui_ReceiptCopyMaskDialog.h ui/ui_UserManualDialog.h ui/ui_SingleFrameExportDialog.h ui/ui_OverwriteListDialog.h ui/ui_PixelMapListDialog.h ui/ui_TranscodeDialog.h ui/ui_StatusFpmDialog.h $(OBJECTS) obj/MLVApp_resource_res.o
	$(LINKER) $(LFLAGS) -o $(DESTDIR_TARGET) @obj/object_script.MLVApp.Debug $(LIBS)

obj/MLVApp_resource_res.o: MLVApp_resource.rc
	windres -i MLVApp_resource.rc -o obj/MLVApp_resource_res.o --include-dir=. $(DEFINES)

qmake: FORCE
	@$(QMAKE) -o Makefile.Debug MLVApp.pro

qmake_all: FORCE

dist:
