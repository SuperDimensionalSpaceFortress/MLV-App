platform/build-*
*build*
# build-provenance TOOLING (source scripts, not build output) -- re-include despite *build* above
!tools/build-release.ps1
!tools/gen-buildinfo.ps1
!tools/release/build_stamp.py
!tools/repo_hygiene/test_build_stamp.py
!tools/coordination/build-guard.ps1
!tests/coordination/test_build_guard.py
.qtcreator

# Docs tree is the canonical documentation set; track it even if filenames
# happen to contain "build" (e.g. 10-build-windows.md).
!docs/
!docs/**

# Agent working state — profiling runs, ephemeral analysis, stashed artifacts.
# Durable findings go under .claude/ and are tracked; .claude-state/ is scratch.
.claude-state/

# Local nested agent worktrees are load-bearing but not repo content.
.claude/worktrees/

# Profiling scratch DNGs are large, disposable, and reproducible; the
# metadata/evidence files that accompany them stay tracked. Goldens under
# tests/fixtures/ are unaffected.
.claude/**/*.dng

# Local property-test cache.
.hypothesis/

# Local agent prompt scratch.
CLAUDE_CODE_PROMPTS.md

# Per-machine Claude Code settings (permissions, local hooks). The shared
# .claude/settings.json (if it exists) is tracked; this one stays local.
.claude/settings.local.json

# Claude Desktop scheduled-task runtime lock. This can be live while the
# independent review loop is running and must not block repo closeout.
.claude/scheduled_tasks.lock

# Local bridge monitor/runtime breadcrumbs should live under bridge state or
# scratch; ignore accidental root-level drops.
monitor-*.runtime.json
peer-*.runtime.json
watcher.runtime.json
presence-*.runtime.json
.bridge-state/
bridge-root.json
MOVED_TO.json

# Python bytecode (e.g. tools/agent-bridge/)
__pycache__/
*.pyc
*.pyo

# Extracted local FFmpeg binary; release archives above remain tracked.
platform/qt/FFmpeg/ffmpeg.exe

# Fleet doctrine sync marker + fold notes written by the bus tool
# (softwarefactory-fleet-doctrine tools/doctrine-sync.mjs). Consumer-local
# state, per-machine, never work product - same treatment as .claude-state/.
.codex-state/
