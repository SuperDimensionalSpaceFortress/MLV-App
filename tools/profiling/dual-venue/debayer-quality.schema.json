{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlv-app/debayer-quality/v1",
  "title": "Debayer quality pass result (EXPORT-DEBAYER-QUALITY-1)",
  "description": "quality.json: written ON THE VENUE by debayer_quality.py from the untimed quality run's pipeline-stage captures. Scalars, tile indices, isoValue and the sha256 of each captured buffer only: never a capture, a frame, a path or a file name. Test-DvDebayerQualityRefusal (DualVenueRunner.psm1) refuses the same shape.",
  "type": "object",
  "required": ["schema", "card", "result", "receiptDebayer", "debayer", "captureOffsets", "frames", "stages", "tileSize", "tilesPerClass", "border", "isoValue", "levelSource", "cfaSource", "perFrame", "metrics"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "mlv-app/debayer-quality/v1" },
    "card": { "const": "EXPORT-DEBAYER-QUALITY-1" },
    "result": { "const": "QUALITY_CAPTURED" },
    "receiptDebayer": { "type": "integer", "minimum": 0, "maximum": 8 },
    "debayer": { "enum": ["none", "simple", "bilinear", "lmmse", "igv", "amaze", "ahd", "rcd", "dcb"] },
    "captureOffsets": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "integer", "minimum": 0, "maximum": 23 } },
    "frames": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "stages": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "enum": ["S2_post_dualiso", "S3_debayer", "S4_processing"] } },
    "tileSize": { "type": "integer", "minimum": 8, "maximum": 512 },
    "tilesPerClass": { "type": "integer", "minimum": 1, "maximum": 256 },
    "border": { "const": 32 },
    "isoValue": { "type": "integer", "minimum": 0 },
    "levelSource": { "enum": ["rawi", "observed"] },
    "cfaSource": { "enum": ["rawi", "default-rggb"] },
    "perFrame": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["frame", "sha256", "flatTiles", "edgeTiles", "metrics"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "propertyNames": { "enum": ["S2_post_dualiso", "S3_debayer", "S4_processing"] } },
          "flatTiles": { "$ref": "#/$defs/tiles" },
          "edgeTiles": { "$ref": "#/$defs/tiles" },
          "metrics": { "$ref": "#/$defs/stageMetrics" }
        }
      }
    },
    "metrics": { "$ref": "#/$defs/stageMetrics" }
  },
  "$defs": {
    "tiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
    "metricSet": {
      "type": "object", "additionalProperties": false, "required": ["ncge", "sigmaY", "sigmaC1", "sigmaC2", "sigmaC", "fc"],
      "properties": { "ncge": { "type": "number" }, "sigmaY": { "type": "number", "minimum": 0 }, "sigmaC1": { "type": "number", "minimum": 0 },
                      "sigmaC2": { "type": "number", "minimum": 0 }, "sigmaC": { "type": "number", "minimum": 0 }, "fc": { "type": "number", "minimum": 0 } }
    },
    "stageMetrics": {
      "type": "object", "additionalProperties": false,
      "properties": { "S3_debayer": { "$ref": "#/$defs/metricSet" }, "S4_processing": { "$ref": "#/$defs/metricSet" } }
    }
  }
}
